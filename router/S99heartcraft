#!/bin/sh
# Entware autostart: rc.unslung calls it when the router boots.
# start-stop-daemon -b detaches the keeper, otherwise it dies with the ssh session.
case "$1" in
    start)
        pgrep -f "/opt/heartcraft/keeper.sh" >/dev/null 2>&1 || \
            start-stop-daemon -S -b -x /opt/heartcraft/keeper.sh
        ;;
    stop)
        for name in keeper.sh server.py; do
            for pid in $(pgrep -f "/opt/heartcraft/$name" 2>/dev/null); do
                kill "$pid" 2>/dev/null
            done
        done
        ;;
    restart)
        "$0" stop; sleep 2; "$0" start
        ;;
esac
